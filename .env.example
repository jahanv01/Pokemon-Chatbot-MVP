# Gemini free tier: get a key at https://aistudio.google.com/apikey
LLM_MODEL=google_genai:gemini-3.5-flash-lite
# Backups tried in order if the main model fails (e.g. its free daily quota is used up)
LLM_FALLBACK_MODELS=google_genai:gemini-3.5-flash

GOOGLE_API_KEY=your-gemini-key-here
# Login users must enter to chat. Share it only with people allowed to use your API key.
APP_ACCESS_USERNAME=xyz
APP_ACCESS_PASSWORD=password
# POKEAPI_BASE_URL=https://pokeapi.co/api/v2
# CACHE_TTL_SECONDS=3600
# NOT_FOUND_TTL_SECONDS=60
# RECURSION_LIMIT=16
